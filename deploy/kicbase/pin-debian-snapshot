# Point Debian apt sources at the snapshot the base image was built from.
# The image comments that URL and then sets URIs to the rolling mirror.
# Called once, before the Dockerfile fetches the Debian package index.

set -eu

src=/etc/apt/sources.list.d/debian.sources
tmp=$(mktemp)

if [ ! -f "$src" ]; then
  echo >&2 "pin-debian-snapshot: ${src} not found"
  exit 1
fi

if ! awk '
  /^# http:\/\/snapshot\.debian\.org\/archive\// { snap=$2; print; next }
  /^Check-Valid-Until:/ { next }
  /^URIs: / && snap != "" {
    print "URIs: " snap
    print "Check-Valid-Until: no"
    snap=""
    pinned++
    next
  }
  { print }
  END { if (pinned < 1) exit 1 }
' "$src" > "$tmp"; then
  rm -f "$tmp"
  echo >&2 "pin-debian-snapshot: ${src} has no snapshot.debian.org comment"
  exit 1
fi

mv "$tmp" "$src"
